---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/projects-layout.astro";
import EntryDetail from "@/components/Portfolio/EntryDetail.astro";
import { getPortfolioEntry, portfolio } from "@/data/portfolio";

export const getStaticPaths = (() =>
  portfolio.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const currentEntry = entry ?? getPortfolioEntry(Astro.params.slug ?? "");

if (!currentEntry) {
  return Astro.redirect("/proyectos");
}
---

<Layout
  title={`${currentEntry.title} | Vicente Rivera`}
  description={currentEntry.summary}
>
  <EntryDetail entry={currentEntry} />
</Layout>
