---
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();
const { maxWidth = "max-w-6xl" } = Astro.props;
---

<footer
  class=`mx-auto w-[calc(100%-2rem)] py-10 flex justify-between items-center text-sm text-gray-300 ${maxWidth}`
>
  <p class="text-center">
    © {year} Vicente Rivera.
  </p>
  <div class="flex gap-x-4">
    <a
      href="https://github.com/vcntttt"
      target="_blank"
      rel="noreferrer"
      aria-label="Ir a mi Github"
    >
      <Icon name="github" />
    </a>
    <a
      href="https://www.linkedin.com/in/vriverainf/"
      target="_blank"
      rel="noreferrer"
      aria-label="Ir a mi Linkedin"
    >
      <Icon name="linkedin" />
    </a>
  </div>
</footer>
