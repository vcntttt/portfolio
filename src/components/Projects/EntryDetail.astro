---
import { Icon } from "astro-icon/components";
import { render, type CollectionEntry } from "astro:content";
import BackLink from "@/components/Navigation/BackLink.astro";
import {
  categoryLabels,
  getTechnologyGroups,
  linkDescriptions,
  linkIcons,
  resolveProjectSummary,
  statusLabels,
  technologyIconClass,
  technologyIconSources,
  technologyIcons,
} from "@/data/project-presentation";
import type { PortfolioEntry } from "@/types";

interface Props {
  entry: PortfolioEntry;
  project?: CollectionEntry<"projects">;
}

const { entry, project } = Astro.props;
const { Content } = project ? await render(project) : { Content: undefined };
const summary = resolveProjectSummary(entry, project);
const technologySections = getTechnologyGroups(project);
---

<main class="mx-auto w-[calc(100%-2rem)] max-w-6xl">
  <div class="py-10 md:py-16">
    <BackLink href="/proyectos" label="Volver a proyectos" />

    <header class="mt-8 max-w-4xl">
      <p class="mb-3 text-sm text-sky-200/75">{categoryLabels[entry.category]} · {statusLabels[entry.status]} · {entry.date}</p>
      <h1 class="text-4xl font-semibold tracking-tight md:text-6xl">{entry.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-white/75">{summary}</p>
    </header>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
      <article class="project-content min-w-0">
        {Content ? <Content /> : <p>{summary}</p>}
      </article>

      <aside class="space-y-8 lg:pt-2">
        {technologySections.length > 0 && (
          <section class="tech-stack border-t border-white/15 pt-4">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="text-sm font-medium uppercase tracking-[0.16em] text-white/55">Tecnologías</h2>
            </div>

            <div class="mt-4 space-y-5">
              {technologySections.map((group) => (
                <div>
                  {group.name && <h3 class="mb-2 text-[0.68rem] font-medium uppercase tracking-[0.14em] text-sky-200/60">{group.name}</h3>}
                  <ul class="grid grid-cols-2 gap-x-3 gap-y-2 lg:grid-cols-1">
                    {group.items.map((technology) => (
                      <li class="flex min-w-0 items-center gap-2 border-b border-white/10 pb-2 text-sm text-white/80">
                        {
                          technologyIconSources[technologyIcons[technology]] ? (
                            <img
                              src={technologyIconSources[technologyIcons[technology]]}
                              class={technologyIconClass(technology)}
                              alt=""
                              aria-hidden="true"
                            />
                          ) : technologyIcons[technology] ? (
                            <Icon name={technologyIcons[technology]} class={technologyIconClass(technology)} aria-hidden="true" />
                          ) : (
                            <span class="flex size-5 shrink-0 items-center justify-center rounded-sm bg-cyan-200/10 text-[0.6rem] font-semibold text-cyan-100/80" aria-hidden="true">
                              {technology.charAt(0).toUpperCase()}
                            </span>
                          )
                        }
                        <span class="truncate">{technology}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )}

        {entry.links && entry.links.length > 0 && (
          <section class="border-t border-white/15 pt-4">
            <h2 class="text-sm font-medium uppercase tracking-[0.16em] text-white/50">Enlaces</h2>
            <ul class="mt-4 grid gap-2">
              {entry.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noreferrer"
                    class="group flex items-center gap-3 rounded-lg border border-white/10 bg-white/[0.025] px-3 py-2.5 transition-colors hover:border-sky-200/35 hover:bg-sky-200/[0.06]"
                  >
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-white/[0.08] text-white/85 transition-colors group-hover:bg-sky-200/15 group-hover:text-sky-100">
                      <Icon name={linkIcons[link.label] ?? "external-link"} class="size-4" aria-hidden="true" />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm text-white/85">{link.label}</span>
                      <span class="mt-0.5 block truncate text-xs text-white/45">{linkDescriptions[link.label] ?? "Abrir enlace externo"}</span>
                    </span>
                    <Icon name="arrow-right" class="size-4 shrink-0 text-white/45 transition-transform group-hover:translate-x-0.5 group-hover:text-sky-100" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </div>
</main>

<style is:global>
  .project-content {
    max-width: none;
    color: rgb(255 255 255 / 0.82);
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  .project-content h2,
  .project-content p:not(:has(> img)),
  .project-content ul,
  .project-content blockquote {
    max-width: 44rem;
  }

  .project-content p:has(> img) {
    max-width: 52rem;
  }

  .project-content img {
    display: block;
    width: 100%;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 0.75rem;
  }

  .project-content h2 {
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
    color: rgb(255 255 255 / 0.96);
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .project-content h2:first-child {
    margin-top: 0;
  }

  .project-content p {
    margin-top: 1rem;
  }

  .project-content ul {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .project-content li + li {
    margin-top: 0.4rem;
  }

  .project-content blockquote {
    margin: 1.5rem 0;
    border-left: 2px solid rgb(125 211 252 / 0.55);
    padding-left: 1rem;
    color: rgb(255 255 255 / 0.68);
  }

  .project-content a {
    color: rgb(186 230 253 / 0.9);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
