---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import {
  categoryLabels,
  isContainedPreview,
  statusLabels,
} from "@/data/project-presentation";
import type { PortfolioEntry } from "@/types";

interface Props {
  entry: PortfolioEntry;
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const containedImage = isContainedPreview(entry.slug);
---

<article
  class:list={[
    "group relative overflow-hidden rounded-xl border border-white/20 shadow-inner shadow-white/10",
    compact ? "col-span-12 md:col-span-6" : "col-span-12",
  ]}
>
  <div class="absolute inset-0 z-10 h-full w-full bg-gradient-to-b from-transparent from-35% via-[#121212]/20 to-[#121212]" aria-hidden="true"></div>

  {
    entry.image ? (
      <Image
        src={entry.image}
        alt={`Vista previa de ${entry.title}`}
        class:list={[
          "absolute -z-10 h-full w-full opacity-90 object-cover transition duration-1000 ease-in-out group-hover:scale-105 group-hover:opacity-50",
          containedImage ? "object-contain bg-[#0f172a] p-10" : "object-top",
        ]}
        loading="lazy"
      />
    ) : (
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_20%,rgba(96,165,250,.25),transparent_35%),linear-gradient(135deg,#1e293b,#0f172a)]" aria-hidden="true"></div>
    )
  }

  <a
    href={`/proyectos/${entry.slug}`}
    class="absolute inset-0 z-10 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:ring-inset"
    aria-label={`Abrir caso de ${entry.title}`}
  ></a>

  <div class="pointer-events-none relative z-20 flex h-full flex-col justify-between p-5 text-lg md:p-6">
    <div class="flex items-start justify-between gap-4">
      <p class="rounded-md bg-[#121212]/60 px-2 py-1 text-sm text-white">{categoryLabels[entry.category]}</p>
      <div class="flex max-w-[70%] flex-wrap justify-end gap-2">
        {entry.links?.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="pointer-events-auto relative z-30 flex items-center gap-2 rounded-md bg-[#121212]/70 px-2 py-1 text-sm text-white hover:underline"
          >
            {link.label}
            <Icon name="external-link" class="size-4" />
          </a>
        ))}
      </div>
    </div>

    <div>
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <h3 class="text-2xl font-semibold text-white">
          <span class="underline">{entry.title}</span>
        </h3>
        <span class="rounded-md bg-[#121212]/60 px-2 py-1 text-xs text-white/80">{statusLabels[entry.status]}</span>
      </div>
      <p class="max-w-3xl text-balance text-base text-white md:text-lg">{entry.summary ?? ""}</p>
      <p class="text-sm text-white/70">{entry.date}</p>
    </div>
  </div>
</article>
