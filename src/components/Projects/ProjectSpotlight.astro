---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import {
  categoryLabels,
  getProjectSummary,
  linkIcons,
} from "@/data/project-presentation";
import type { ProjectContentBySlug } from "@/data/project-presentation";
import type { PortfolioEntry } from "@/types";

interface Props {
  entries: PortfolioEntry[];
  contentBySlug: ProjectContentBySlug;
}

// Shows the first two entries as posters: a wide featured one and a narrow secondary one.
// Each image needs empty space in its lower half, where the text sits.
const { entries, contentBySlug } = Astro.props;
const cards = entries.slice(0, 2).map((entry, index) => {
  const image = entry.spotlightImage ?? entry.image;
  return {
    entry,
    featured: index === 0,
    image,
    portrait: image ? image.height > image.width : false,
    summary: getProjectSummary(entry, contentBySlug),
  };
});
---

{cards.length > 0 && (
  <div class="grid gap-4 md:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)] md:items-stretch">
    {cards.map(({ entry, featured, image, portrait, summary }) => (
      <article class="group relative isolate overflow-hidden rounded-[1.6rem] border border-white/20 bg-[#060b1c] shadow-2xl shadow-black/25">
        {/* On mobile the image is a band above the text; from md up it fills the card behind it. */}
        <div class="absolute inset-x-0 top-0 -z-10 h-80 overflow-hidden md:inset-0 md:h-auto" aria-hidden="true">
          {image && (
            <Image
              src={image}
              alt=""
              class:list={[
                "h-[34rem] w-full object-cover object-[75%_0%] transition duration-1000 group-hover:scale-105 md:mt-0 md:h-full md:object-top",
                !portrait && "mt-12 [mask-image:linear-gradient(180deg,transparent,black_12%)] md:[mask-image:none]",
              ]}
              loading="lazy"
            />
          )}
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,11,28,0)_0%,rgba(6,11,28,0)_45%,rgba(6,11,28,.8)_80%,#060b1c_100%)] md:bg-[linear-gradient(180deg,rgba(6,11,28,0)_0%,rgba(6,11,28,0)_40%,rgba(6,11,28,.7)_58%,rgba(6,11,28,.95)_75%)]"></div>
        </div>

        <a
          href={`/proyectos/${entry.slug}`}
          class="absolute inset-0 z-10 rounded-[1.6rem] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-inset"
          aria-label={`Abrir caso de ${entry.title}`}
        ></a>

        <div class:list={["pointer-events-none relative z-20 flex flex-col justify-end px-6 pb-6 pt-64 text-white md:min-h-[37rem]", featured ? "md:p-9" : "md:p-7"]}>
          <div>
            <h3
              class:list={[
                "font-semibold text-white text-balance",
                featured
                  ? "text-[clamp(3.5rem,9vw,7rem)] leading-[0.85] tracking-[-0.07em]"
                  : "text-[2rem] leading-[1.02] tracking-[-0.04em]",
              ]}
            >
              {entry.title}
            </h3>
            <p class:list={["mt-5 text-white/75", featured ? "max-w-xl text-lg leading-8" : "leading-7"]}>{summary}</p>
            <dl class="mt-6 text-sm">
              <dt class="text-[0.68rem] uppercase tracking-[0.08em] text-white/40">Tipo</dt>
              <dd class="mt-1 text-white/85">{categoryLabels[entry.category]}</dd>
            </dl>
            {entry.links && entry.links.length > 0 && (
              <div class:list={["pointer-events-auto mt-5 grid w-full overflow-hidden rounded-xl bg-black/25 text-[0.8rem] backdrop-blur-sm", featured && "sm:grid-cols-3"]}>
                {entry.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer" class="group/link relative z-30 flex min-h-12 items-center justify-between gap-2 border-t border-white/10 bg-white/[0.03] px-3 py-2 text-white/80 transition first:border-t-0 hover:bg-white/[0.1] sm:border-l sm:border-t-0 sm:first:border-l-0">
                    <span class="flex min-w-0 items-center gap-2">
                      <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-white/[0.06] text-white/75">
                        <Icon name={linkIcons[link.label] ?? "external-link"} class="size-4" />
                      </span>
                      <span class="truncate">{link.label}</span>
                    </span>
                    <Icon name="external-link" class="size-3.5 shrink-0 text-white/45 transition-transform group-hover/link:translate-x-0.5 group-hover/link:text-white/80" />
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
)}
