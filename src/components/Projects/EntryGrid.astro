---
import type { PortfolioEntry } from "@/types";
import EntryCard from "./EntryCard.astro";

interface Props {
  entries: PortfolioEntry[];
  compact?: boolean;
}

const { entries, compact = false } = Astro.props;
---

<div class:list={[
  "grid w-full max-w-full grid-cols-12 gap-4",
  compact ? "auto-rows-[28rem]" : "auto-rows-[25rem]",
]}>
  {entries.map((entry) => <EntryCard entry={entry} compact={compact} />)}
</div>
