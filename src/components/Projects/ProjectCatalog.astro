---
import { Image } from "astro:assets";
import {
  categoryLabels,
  getProjectSummary,
  isContainedPreview,
  statusLabels,
} from "@/data/project-presentation";
import type { ProjectContentBySlug } from "@/data/project-presentation";
import type { PortfolioEntry } from "@/types";

interface Props {
  entries: PortfolioEntry[];
  contentBySlug: ProjectContentBySlug;
}

const { entries, contentBySlug } = Astro.props;
---

<div class="border-t border-white/15">
  {entries.map((entry) => (
    <article class="group grid gap-4 py-6 transition-colors hover:bg-white/[0.02] md:grid-cols-[9rem_minmax(0,1fr)] md:items-center md:gap-6">
      {
        entry.image ? (
          <Image
            src={entry.image}
            alt={`Vista previa de ${entry.title}`}
            class:list={[
              "h-24 w-full rounded-md bg-[#0f172a] object-cover opacity-80 transition duration-300 group-hover:opacity-100",
              isContainedPreview(entry.slug) ? "object-contain p-2" : "object-top",
            ]}
            loading="lazy"
          />
        ) : (
          <div class="flex h-24 items-center justify-center rounded-md bg-[#111827] text-3xl font-semibold text-white/20" aria-hidden="true">
            {entry.title.slice(0, 1)}
          </div>
        )
      }

      <div class="min-w-0">
        <div class="mb-1 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm opacity-70">
          <div class="flex items-center gap-x-2">
            <span>{categoryLabels[entry.category]}</span>
            <span>·</span>
            <span>{statusLabels[entry.status]}</span>
          </div>
          <span class="opacity-60">{entry.date}</span>
        </div>
        <h2 class="text-2xl font-semibold">
          <a href={`/proyectos/${entry.slug}`} class="underline decoration-white/30 underline-offset-4 transition hover:decoration-white">
            {entry.title}
          </a>
        </h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 opacity-80">{getProjectSummary(entry, contentBySlug)}</p>
      </div>
    </article>
  ))}
</div>
