---
import { Icon } from "astro-icon/components";
import type { Credential } from "@/types";

interface Props {
  items: Credential[];
}

const { items } = Astro.props;
---

<div class="flex w-full flex-col gap-4 md:flex-row md:flex-wrap">
  {items.map((credential) => (
    <article class:list={[
      "flex flex-1 flex-col justify-between gap-4 rounded-md bg-black/60 p-5",
      credential.featured ? "md:basis-full" : "md:min-w-[16rem]",
    ]}>
      <div>
        <div class="flex items-start justify-between gap-4">
          <div class="flex min-w-0 items-start gap-3">
            {credential.icon && (
              <Icon name={credential.icon} class="mt-0.5 size-8 shrink-0" aria-hidden="true" />
            )}
            <div class="min-w-0">
              <h3 class="text-xl font-semibold">{credential.title}</h3>
              <p class="mt-1">{credential.issuer}</p>
            </div>
          </div>
          {credential.link && (
            <a href={credential.link} target="_blank" rel="noreferrer" class="shrink-0 text-cyan-200 hover:text-white" aria-label={`Ver credencial de ${credential.title}`}>
              <Icon name="external-link" class="size-6 text-white" />
            </a>
          )}
        </div>
        {credential.detail && <p class="mt-3 text-sm opacity-80">{credential.detail}</p>}
        {credential.description && <p class="mt-3 text-sm leading-6 opacity-90">{credential.description}</p>}
      </div>
      {credential.date && <p class="text-xs text-slate-500">{credential.date}</p>}
    </article>
  ))}
</div>
