---
import SocialSection from "@/components/Social/SocialSection.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import avatar from "@/assets/avatar.jpg";
---

<Image
  src={avatar}
  alt="Vicente Rivera"
  class="mb-6 size-32 rounded-full"
  width={128}
  height={128}
  loading="eager"
/>

<h1 class="flex gap-x-4 pb-4 text-4xl font-bold md:text-5xl">Hola, me llamo Vicente Rivera.</h1>
<h2 class="max-w-3xl text-xl text-wrap opacity-80">
  <span>Desarrollador de software.</span> Estudiante de Ingeniería Civil en Informática,
  interesado en desarrollo web, aplicaciones móviles y análisis de datos desde Temuco, Chile.
</h2>
<SocialSection />
