---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { PortfolioEntry } from "@/types";

interface Props {
  entry: PortfolioEntry;
}

const { entry } = Astro.props;
const heroImage = entry.detailImage ?? entry.image;

const categoryLabels = {
  professional: "Trabajo",
  product: "Proyecto personal",
  academic: "Proyecto académico",
  research: "Investigación",
} as const;

const statusLabels = {
  live: "En uso",
  delivered: "Prototipo entregado",
  "in-progress": "En desarrollo",
  finished: "Completado",
  private: "Repositorio privado",
} as const;
---

<main class="mx-4 max-w-6xl md:mx-auto">
  <div class="py-10 md:py-16">
    <a href="/proyectos" class="flex items-center gap-x-1 underline">
      <Icon name="arrow-left" /> Volver a proyectos
    </a>

    <h1 class="mb-4 mt-8 text-4xl font-semibold md:text-5xl">Página de {entry.title}</h1>
    <p class="mb-2 opacity-80">{categoryLabels[entry.category]} · {statusLabels[entry.status]} · {entry.date}</p>
    <p class="max-w-3xl text-lg">{entry.summary}</p>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={`Vista de ${entry.title}`}
          class="mt-8 max-h-[32rem] w-full rounded-md object-cover object-top"
          loading="eager"
        />
      )
    }

    <div class="mt-8 grid gap-8 md:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="space-y-6">
        {entry.context && <section><h2 class="mb-2 text-2xl font-semibold">Contexto</h2><p>{entry.context}</p></section>}
        {entry.role && <section><h2 class="mb-2 text-2xl font-semibold">Mi rol</h2><p>{entry.role}</p></section>}
        {entry.scope && <section><h2 class="mb-2 text-2xl font-semibold">Alcance</h2><p>{entry.scope}</p></section>}
        {entry.outcome && <section><h2 class="mb-2 text-2xl font-semibold">Resultado</h2><p>{entry.outcome}</p></section>}

        {entry.highlights && (
          <section>
            <h2 class="mb-2 text-2xl font-semibold">Características</h2>
            <ul class="list-inside list-disc space-y-1">
              {entry.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </section>
        )}
      </div>

      <aside class="space-y-6">
        {entry.technologies && (
          <section>
            <h2 class="mb-2 text-2xl font-semibold">Tecnologías</h2>
            <p>{entry.technologies.join(" · ")}</p>
          </section>
        )}

        {entry.links && entry.links.length > 0 && (
          <section>
            <h2 class="mb-2 text-2xl font-semibold">Enlaces</h2>
            <ul class="space-y-1">
              {entry.links.map((link) => <li><a href={link.href} target="_blank" rel="noreferrer" class="underline">{link.label} <Icon name="external-link" class="inline size-4" /></a></li>)}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </div>
</main>
