---
import type { Experience } from "@/types";

interface Props {
  items: Experience[];
}

const { items } = Astro.props;
---

<div class="relative border-y border-white/10">
  <span class="pointer-events-none absolute bottom-8 left-0 top-8 w-px bg-sky-200/25 md:left-[calc(12rem+2.5rem)]" aria-hidden="true"></span>
  {items.map((item) => (
    <article class="grid min-w-0 gap-5 py-7 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10">
      <div>
        <p class="whitespace-nowrap font-mono text-xs uppercase tracking-[0.14em] text-slate-400">{item.date}</p>
        {item.location && <p class="mt-1 whitespace-nowrap text-xs uppercase tracking-[0.14em] text-slate-500">{item.location}</p>}
      </div>

      <div class="relative min-w-0 pl-6">
        <span class="absolute -left-[4px] top-1.5 z-10 size-2 rounded-full bg-sky-300 ring-4 ring-[#0f172a]" aria-hidden="true"></span>
        <div class="flex min-w-0 flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-xl font-semibold text-slate-50">{item.title}</h3>
          {item.organizationUrl ? (
            <a href={item.organizationUrl} target="_blank" rel="noreferrer" class="text-sky-200/80 underline-offset-4 transition hover:text-sky-100 hover:underline">
              {item.organization}
            </a>
          ) : (
            <p class="text-sky-200/80">{item.organization}</p>
          )}
        </div>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-300">{item.description}</p>
      </div>
    </article>
  ))}
</div>
